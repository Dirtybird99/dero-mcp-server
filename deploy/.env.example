# Copy to .env and edit. Do not commit .env.

# Public hostname Caddy serves on (the A record points here).
# Example: mcp.derod.org
DOMAIN=mcp.derod.org

# docker-compose passes DOMAIN to DERO_MCP_ALLOWED_HOSTS. HTTP mode requires
# this lowercase hostname-only allowlist for its non-loopback (0.0.0.0) bind.
# Entries never include a scheme or port. Standalone deployments must set
# DERO_MCP_ALLOWED_HOSTS themselves.
# Standalone equivalent: DERO_MCP_ALLOWED_HOSTS=mcp.derod.org

# Optional comma-separated lowercase browser Origin hostnames (no schemes or
# ports), for example: app.example.com,chat.example.com
# Empty rejects any request that presents an Origin header; non-browser clients
# that omit Origin still pass.
DERO_MCP_ALLOWED_ORIGINS=

# Email for Let's Encrypt failure notifications.
ACME_EMAIL=admin@example.com

# Version of dero-mcp-server to install in the container. Pin to a
# specific release; track CHANGELOG.md for upgrades.
DERO_MCP_VERSION=0.7.0

# JSON-RPC base of the DERO daemon the MCP queries. Three common shapes:
#
#   1. Daemon running on the SAME VPS, outside Docker (recommended):
#      DERO_DAEMON_URL=http://host.docker.internal:10102
#
#   2. Daemon running in another container or on another host:
#      DERO_DAEMON_URL=http://10.0.0.5:10102
#
#   3. Use local-first automatic resolution:
#      DERO_DAEMON_URL=  (empty checks 127.0.0.1:10102, then uses the
#                        disclosed third-party public fallback)
#
# Query parameters are supported and preserved on daemon calls. Do not embed
# URL userinfo (user:password@host); startup rejects it. Query values are
# redacted from logs, /health, server-info, and privacy notices.
DERO_DAEMON_URL=http://host.docker.internal:10102

# Bearer token required on every /mcp request. Generate with:
#   openssl rand -base64 48
# Leave EMPTY if you intentionally want public unauthenticated access
# (e.g. a docs-only demo). Highly recommended to set this if the daemon
# is reachable (any client could otherwise exhaust the daemon's RPC).
DERO_MCP_AUTH_TOKEN=
